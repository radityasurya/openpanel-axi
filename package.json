    "web-analytics",
    "agent",
    "cli",
    "toon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radityasurya/openpanel-axi.git"
  },
  "homepage": "https://github.com/radityasurya/openpanel-axi#readme",
  "bugs": {
    "url": "https://github.com/radityasurya/openpanel-axi/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "openpanel-axi": "bin/openpanel-axi.js"
